# Vorlage — echte Werte kommen aus der Umgebung / Coolify-Secrets, NIE ins Git.

# --- PostgreSQL Warehouse (Phase 1) ---
# Interner Hostname der BESTEHENDEN Postgres-Instanz in Coolify (Service-DNS).
WAREHOUSE_DB_HOST=
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=warehouse
# ETL-Rolle: schreibt raw, liest/schreibt core, baut marts. Owner der DB.
ETL_DB_USER=etl
ETL_DB_PASSWORD=
# Major-Version der bestehenden Instanz (nur fürs Backup-Image, z. B. 16/17).
PG_MAJOR=17
# Backup-Retention in Tagen.
BACKUP_RETENTION_DAYS=14

# metabase_ro-Passwort: NICHT von den Containern hier benötigt. Wird nur im
# Bootstrap-SQL und in der Metabase-Datenquellen-Konfig verwendet.
# METABASE_RO_PASSWORD=

# --- Pipedrive (Zugang via OAuth-MCP; REST-Token nur falls je benötigt) ---
PIPEDRIVE_API_TOKEN=
PIPEDRIVE_COMPANY_DOMAIN=

# --- sevDesk (Phase 3) ---
# Read-only API-Token (Authorization-Header, ohne "Bearer").
SEVDESK_API_TOKEN=
# Basis-URL (Default my.sevdesk.de). Nur überschreiben, falls sevDesk umzieht.
SEVDESK_API_BASE=https://my.sevdesk.de/api/v1
# Rechnungen ab diesem Datum ziehen (Ausbuchungshistorie belastbar ab 2024).
SEVDESK_SINCE=2024-01-01

# --- Feature Flags ---
# Schreibpfad nach Pipedrive (Phase 5). Bleibt bis nach Shadow Mode auf false.
FEATURE_PIPEDRIVE_WRITEBACK=false

# HTTP-Ingest-Dienst (n8n -> Warehouse; n8n ist nicht im DB-Netz)
INGEST_TOKEN=
INGEST_PORT=8080
