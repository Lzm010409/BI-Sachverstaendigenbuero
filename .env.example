# Vorlage — echte Werte kommen aus der Umgebung / Coolify-Secrets, NIE ins Git.

# --- Pipedrive (read-only Token, Phase 0/2) ---
PIPEDRIVE_API_TOKEN=
# Company-Domain ohne https://, z. B. "meinbuero" bei meinbuero.pipedrive.com
PIPEDRIVE_COMPANY_DOMAIN=

# --- sevDesk (Phase 3) ---
SEVDESK_API_TOKEN=

# --- PostgreSQL Warehouse (Phase 1) ---
WAREHOUSE_DB_HOST=
WAREHOUSE_DB_PORT=5432
WAREHOUSE_DB_NAME=warehouse
WAREHOUSE_DB_USER=etl
WAREHOUSE_DB_PASSWORD=

# --- Feature Flags ---
# Schreibpfad nach Pipedrive (Phase 5). Bleibt bis nach Shadow Mode auf false.
FEATURE_PIPEDRIVE_WRITEBACK=false
